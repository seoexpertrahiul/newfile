<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>তথ্য জমা দিন</title>

  <style>
    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      display: grid;
      place-items: center;
      padding: 20px;
      font-family: Arial, sans-serif;
      background: #f1f5f9;
      color: #172033;
    }

    .card {
      width: 100%;
      max-width: 420px;
      padding: 30px;
      background: white;
      border-radius: 18px;
      box-shadow: 0 10px 35px #00000012;
    }

    h1 {
      text-align: center;
      font-size: 25px;
    }

    .subtitle {
      text-align: center;
      color: #64748b;
    }

    label {
      display: block;
      margin: 20px 0 8px;
      font-weight: bold;
    }

    input {
      width: 100%;
      padding: 13px;
      border: 1px solid #cbd5e1;
      border-radius: 9px;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 24px;
      background: #2563eb;
      color: white;
      border: 0;
      border-radius: 9px;
      font-size: 16px;
      cursor: pointer;
    }

    button:disabled { opacity: .6; }

    #message {
      text-align: center;
      font-size: 14px;
    }
  </style>
</head>

<body>
  <main class="card">
    <h1>তথ্য জমা দিন</h1>
    <p class="subtitle">আপনার নাম ও মোবাইল নম্বর লিখুন।</p>

    <form id="contactForm">
      <label for="name">আপনার নাম</label>
      <input
        id="name"
        type="text"
        maxlength="100"
        placeholder="সম্পূর্ণ নাম"
        required
      >

      <label for="phone">মোবাইল নম্বর</label>
      <input
        id="phone"
        type="tel"
        inputmode="numeric"
        maxlength="11"
        pattern="01[3-9][0-9]{8}"
        placeholder="01712345678"
        required
      >

      <button id="submitBtn" type="submit">
        তথ্য জমা দিন
      </button>

      <p id="message" role="status" aria-live="polite"></p>
    </form>
  </main>

  <script>
    // ধাপ ৩-এ পাওয়া Web App URL এখানে বসাবে।
    const SCRIPT_URL = "https://script.google.com/macros/s/AKfycbxgNoloI05pEwvHQ6i-r07taMqmHb6vZLtdWGZLKJbB5KmmlG0xqY_TUgCbYe-pT-OWEA/exec";

    const form = document.getElementById("contactForm");
    const button = document.getElementById("submitBtn");
    const message = document.getElementById("message");

    form.addEventListener("submit", async function(event) {
      event.preventDefault();

      if (!form.reportValidity()) return;

      if (!SCRIPT_URL.startsWith("https://script.google.com/")) {
        message.textContent = "Apps Script URL বসানো হয়নি।";
        return;
      }

      button.disabled = true;
      message.textContent = "তথ্য পাঠানো হচ্ছে...";

      try {
        const data = new URLSearchParams();
        data.append("name", document.getElementById("name").value.trim());
        data.append("phone", document.getElementById("phone").value.trim());

        await fetch(SCRIPT_URL, {
          method: "POST",
          mode: "no-cors",
          body: data
        });

        message.textContent =
          "অনুরোধ পাঠানো হয়েছে। Sheet-এ তথ্য এসেছে কি না যাচাই করুন।";
        form.reset();

      } catch (error) {
        message.textContent =
          "অনুরোধ পাঠানো যায়নি। ইন্টারনেট ও URL পরীক্ষা করুন।";
      } finally {
        button.disabled = false;
      }
    });
  </script>
</body>
</html>
